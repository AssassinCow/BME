+    trainer.train_joint_model(inputs, {"fit"}, config, tmp_path / "baseline", "model", epochs=3, resume=False)
+    monkeypatch.setattr(trainer, "proposal_supervision", optimized)
+    trainer.train_joint_model(inputs, {"fit"}, config, tmp_path / "optimized", "model", epochs=3, resume=False)
+    baseline = torch.load(tmp_path / "baseline/latest.pt", map_location="cpu", weights_only=True)
+    actual = torch.load(tmp_path / "optimized/latest.pt", map_location="cpu", weights_only=True)
+    for name in baseline["model"]:
+        torch.testing.assert_close(baseline["model"][name], actual["model"][name], rtol=0, atol=0)
+    assert len(snapshots["baseline"]) == len(snapshots["optimized"])
+    for baseline_gradients, actual_gradients in zip(snapshots["baseline"], snapshots["optimized"]):
+        for name, value in baseline_gradients.items():
+            if value is None:
+                assert actual_gradients[name] is None
+            else:
+                torch.testing.assert_close(value, actual_gradients[name], rtol=0, atol=0)
