+                        for index, name in enumerate(("first", "second"))},
+        geometry=SimpleNamespace(supervised_steps=4))
+    monkeypatch.setattr(trainer, "make_joint_dataset", lambda *args, **kwargs:
+                        (dataset, {"training_subjects": ["fit"]}))
+
+    def batches(dataset, sampler, config):
+        for chunk in sampler.chunks[sampler.start_chunk:]:
+            row, _, _, key, _, _ = chunk
+            batch = synthetic_batch(config, 20)
+            shift = (row % 8 - 19) * 3000
+            batch["timestamp_ms"] += shift
+            batch["timeline_position"] += row % 8 - 19
+            batch["state_target"] = (torch.arange(20)[None].remainder(2).float() if kind == "binary"
+                                      else torch.full((1, 20), .37))
+            batch["onset_target"], batch["offset_target"] = torch.zeros(1, 20), torch.zeros(1, 20)
+            for name in ("state_loss_mask", "onset_loss_mask", "offset_loss_mask", "smooth_mask", "smooth_loss_mask"):
+                batch[name] = torch.ones(1, 20)
+            batch["subject_key"], batch["session_id"] = key
+            yield batch
+
+    monkeypatch.setattr(trainer, "session_loader", batches)
+    snapshots = {"baseline": [], "optimized": []}
+    save = trainer.save_torch_atomic
+
+    def capture_gradients(path, payload):
+        if "gradients" in payload:
+            snapshots[path.relative_to(tmp_path).parts[0]].append({
+                name: value.clone() if value is not None else None
+                for name, value in payload["gradients"].items()})
+        save(path, payload)
+
+    monkeypatch.setattr(trainer, "save_torch_atomic", capture_gradients)
+    inputs = SimpleNamespace(identity={"data": "same"})
+    optimized = trainer.proposal_supervision
